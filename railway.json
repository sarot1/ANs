{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacks": {
      "pkgs": ["python39", "git", "curl", "wget", "nmap", "bind-tools"]
    }
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyLimit": 10,
    "startCommand": "bash run.sh bot"
  }
}